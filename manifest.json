{
  "manifest_version": 3,
  "name": "Teams Transcript Listener",
  "version": "1.0",
  "permissions": [
    "webRequest",
    "tabs",
    "cookies"
  ],
  "host_permissions": [
    "*://*.sharepoint.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "View Stream Content"
  }
}

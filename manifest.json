{
  "manifest_version": 3,
  "name": "Teams Transcript Viewer",
  "version": "1.0",
  "description": "Captures and displays Microsoft Teams meeting transcripts",
  "permissions": [
    "webRequest",
    "tabs",
    "cookies",
    "clipboardWrite"
  ],
  "host_permissions": [
    "*://*.sharepoint.com/*",
    "*://*.microsoft.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "View Teams Transcript"
  }
}
